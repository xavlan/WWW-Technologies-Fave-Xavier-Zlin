# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techinventory?schema=public

# JWT secret — use a strong random string (min 32 characters) in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# JWT token expiration (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Server port
PORT=3001

# Environment: development | test | production
NODE_ENV=development

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Rate limiting — window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Rate limiting — max requests per window per IP
RATE_LIMIT_MAX=100
